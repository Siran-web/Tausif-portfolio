# ==============================================================================
# Tausif Raza — Architect & Interior Designer Portfolio
# Environment Variables & Resend Email Integration
# ==============================================================================
#
# Automated inquiry emails require Resend (https://resend.com).
# When visitors submit the inquiry form, the system dispatches:
# 1. An owner notification email with project specs and client brief.
# 2. A personalized confirmation email to the visitor.

# 1. Resend API Key (Required for sending automated emails)
# Obtain from: https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxx

# 2. Portfolio Owner Notification Email (Where inquiries are received)
# Defaults to civiarcherdesign@gmail.com if omitted.
CONTACT_EMAIL=your-notification-email@example.com

# 3. Verified Sender Address (Must be a domain authorized on Resend)
# In development/testing, you can use: Tausif Raza <onboarding@resend.dev>
# For production, verify your domain in Resend (resend.com/domains) and use:
EMAIL_FROM=Tausif Raza <hello@your-verified-domain.com>

# 4. Canonical Operating Timezone
# Used for server-side timestamp formatting of project inquiries.
NEXT_PUBLIC_TIMEZONE=Asia/Kolkata

# 5. Social & Profile Links
# Optional: Set owner's actual LinkedIn & Instagram profile URLs
NEXT_PUBLIC_LINKEDIN_URL=https://www.linkedin.com
NEXT_PUBLIC_INSTAGRAM_URL=https://www.instagram.com
