# ==============================================================================
# Architect Portfolio — Environment Variables & Email Integration Configuration
# ==============================================================================
#
# Production Email Integration uses Resend (https://resend.com)
# Inquiries submitted via the Contact / Project Inquiry section will be dispatched
# directly to the architect's mailbox (civiarcherdesigns@gmail.com).

# 1. Resend API Key (Required for sending automated emails)
# Sign up at https://resend.com, generate an API key with sending permissions,
# and place it below. Note: If this key is not configured, the inquiry endpoint
# will return a 503 Setup Required notice rather than silently failing.
RESEND_API_KEY=re_your_resend_api_key_here

# 2. Recipient Mailbox (Optional, defaults to civiarcherdesigns@gmail.com)
# All project inquiry notifications and client briefs will be delivered here.
CONTACT_EMAIL=civiarcherdesigns@gmail.com

# 3. Verified Sender Address (Optional, defaults to onboarding@resend.dev for testing)
# For production deployment with your own custom domain, verify your domain in Resend
# and set this to something like: Ar. Tausif Raza <inquiries@yourdomain.com>
CONTACT_FROM_EMAIL=Ar. Tausif Raza Inquiries <onboarding@resend.dev>

# 4. Canonical Operating Timezone
# Used for server-side timestamp formatting of project inquiries.
# Default: Asia/Kolkata (IST - India Standard Time / UTC+05:30)
NEXT_PUBLIC_TIMEZONE=Asia/Kolkata
